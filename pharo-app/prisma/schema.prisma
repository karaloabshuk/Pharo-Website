generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
}

enum EventType {
  GOAL
  ASSIST
  CLEAN_SHEET
  SAVE
  PENALTY_SAVE
  YELLOW_CARD
  RED_CARD
  OWN_GOAL
  PENALTY_MISS
  DEFENSIVE_CONTRIBUTION
  BONUS
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  fantasyTeam  FantasyTeam?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Team {
  id           String         @id @default(cuid())
  name         String         @unique
  players      Player[]
  homeMatches  Match[]        @relation("HomeTeam")
  awayMatches  Match[]        @relation("AwayTeam")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Player {
  id                    String                @id @default(cuid())
  name                  String
  position              Position
  price                 Float
  teamId                String
  team                  Team                  @relation(fields: [teamId], references: [id])
  matchesPlayed         Int                   @default(0)
  events                MatchEvent[]
  gameweekPoints        PlayerGameweekPoint[]
  fantasyTeamPlayers    FantasyTeamPlayer[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([teamId])
}

model Gameweek {
  id              String               @id @default(cuid())
  number          Int                  @unique
  name            String
  status          String               @default("PENDING")
  matches         Match[]
  playerPoints    PlayerGameweekPoint[]
  managerPoints   ManagerGameweekPoint[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Match {
  id          String         @id @default(cuid())
  homeTeamId  String
  awayTeamId  String
  homeTeam    Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  date        DateTime
  gameweekId  String
  gameweek    Gameweek       @relation(fields: [gameweekId], references: [id])
  status      MatchStatus    @default(UPCOMING)
  homeScore   Int            @default(0)
  awayScore   Int            @default(0)
  events      MatchEvent[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([gameweekId])
}

model MatchEvent {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id])
  eventType EventType
  points    Int
  bonusValue Int?
  createdAt DateTime  @default(now())

  @@index([matchId])
  @@index([playerId])
}

model FantasyTeam {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  user                  User                      @relation(fields: [userId], references: [id])
  name                  String
  budget                Float                     @default(50)
  totalSpent            Float                     @default(0)
  players               FantasyTeamPlayer[]
  captainTeamPlayerId   String?                   @unique
  captainTeamPlayer     FantasyTeamPlayer?        @relation("CaptainSelection", fields: [captainTeamPlayerId], references: [id])
  gameweekPoints        ManagerGameweekPoint[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

model FantasyTeamPlayer {
  id              String          @id @default(cuid())
  fantasyTeamId   String
  fantasyTeam     FantasyTeam     @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  playerId        String
  player          Player          @relation(fields: [playerId], references: [id])
  slotPosition    String
  isBench         Boolean         @default(false)
  isCaptain       Boolean         @default(false)
  fantasyTeamAsCaptain FantasyTeam? @relation("CaptainSelection")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([fantasyTeamId, playerId])
  @@index([fantasyTeamId])
}

model PlayerGameweekPoint {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id])
  gameweekId  String
  gameweek    Gameweek  @relation(fields: [gameweekId], references: [id])
  points      Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([playerId, gameweekId])
  @@index([gameweekId])
}

model ManagerGameweekPoint {
  id              String        @id @default(cuid())
  fantasyTeamId   String
  fantasyTeam     FantasyTeam   @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  gameweekId      String
  gameweek        Gameweek      @relation(fields: [gameweekId], references: [id])
  points          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([fantasyTeamId, gameweekId])
  @@index([gameweekId])
}